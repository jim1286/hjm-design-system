{
  "name": "@hjm/design-system",
  "version": "0.5.1",
  "description": "Platform-neutral design tokens and component recipes shared by HJM products.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./showcase": {
      "types": "./dist/showcase.d.ts",
      "import": "./dist/showcase.js",
      "default": "./dist/showcase.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "showcase:web": "pnpm build && pnpm --filter @hjm/showcase-web storybook",
    "showcase:web:build": "pnpm build && pnpm --filter @hjm/showcase-web build && pnpm --filter @hjm/showcase-web verify:static",
    "showcase:web:check": "pnpm build && pnpm --filter @hjm/showcase-web check",
    "reference:antd:verify": "node scripts/verify-antd-reference.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
