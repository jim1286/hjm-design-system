  "dependencies": {
    "@hjmds/design-contracts": "workspace:*",
    "@hjmds/react": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@number-flow/react": "0.6.2",
    "bloom-menu": "0.1.0",
    "framer-motion": "13.4.4",
    "@dnd-kit/react": "0.5.0",
    "embla-carousel-react": "8.6.0",
    "canvas-confetti": "1.9.4",
    "@dnd-kit/dom": "0.5.0",
    "blobatar": "2.7.0",
    "@blobatar/react": "2.7.0",
    "lucide-react": "1.49.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
