{
  "name": "@hjm/showcase-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:tokens": "node scripts/verify-token-boundary.mjs",
