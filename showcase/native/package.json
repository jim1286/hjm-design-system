{
  "name": "@hjm/showcase-native",
  "version": "0.1.0",
  "private": true,
  "main": ".rnstorybook/index.tsx",
  "scripts": {
    "storybook": "expo start --port 8084",
    "storybook:ios": "expo start --ios --go --port 8084",
    "storybook:generate": "sb-rn-get-stories",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm storybook:generate && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@hjmds/design-contracts": "workspace:*",
    "@hjmds/react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-menu/menu": "1.2.2",
    "@shopify/react-native-skia": "2.6.2",
    "@storybook/addon-ondevice-actions": "10.4.4",
    "@storybook/addon-ondevice-controls": "10.4.4",
    "@storybook/react-native": "10.4.4",
    "expo": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-ios-context-menu": "3.2.1",
    "react-native-ios-utilities": "5.2.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1",
    "react-native-zoom-toolkit": "5.1.1",
    "zeego": "3.0.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "storybook": "10.4.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
