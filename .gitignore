showcase/native/ios/

# Provider trademarks are injected locally from the private portfolio asset registry.
showcase/*/.env.local

# On-demand web/native screen comparison output (scripts/compare-reference-screens.mjs).
artifacts/

# Local-source typecheck config is generated by the shared development adapter.
showcase/*/tsconfig.hjm-local.json

# Vitest 5 browser failure attachments are local diagnostics, like the prior .vitest-attachments output.
packages/*/.vitest/
